{
  "name": "taskflow",
  "version": "1.0.0",
  "description": "Full-stack interview prep project — every file answers a real interview question",
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch src/server/app.ts",
    "dev:client": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "demo:event-loop": "tsx src/js-concepts/event-loop.ts",
    "demo:closures": "tsx src/js-concepts/closures.ts",
    "demo:promises": "tsx src/js-concepts/promises.ts"
  },
  "dependencies": {
    "express": "^5.0.0",
    "@tanstack/react-query": "^5.0.0",
    "zustand": "^4.5.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zod": "^3.23.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "pg": "^8.12.0",
    "ioredis": "^5.4.1",
    "kafkajs": "^2.2.4",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.11.6",
    "@types/cors": "^2.8.17",
    "@types/uuid": "^10.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@testing-library/jest-dom": "^6.4.8",
    "supertest": "^7.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0",
    "jsdom": "^24.1.0",
    "eslint": "^9.0.0"
  }
}

